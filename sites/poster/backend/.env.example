# 生图引擎配置 (复制本文件为同目录 .env 并按需填写)
# 不填任何 Key 时, 默认走免费 Pollinations FLUX 兜底 (速度慢/偶有限流, 但可用)。
#
# 想免费升级质量? 二选一即可 (都不用绑卡、不花钱):
#   1) Google Gemini 免费档  -> 申请 AI Studio Key: https://aistudio.google.com/apikey
#   2) Cloudflare Workers AI -> 申请免费 Token: https://dash.cloudflare.com/profile/api-tokens
# 把对应 Key 填好, 并把 IMAGE_PROVIDER 改成 gemini / cloudflare 即可, 全程 0 元。

# 生图源: pollinations(默认免费) | doubao(豆包/即梦 Seedream)
#        | gemini(Google 免费档) | cloudflare(Cloudflare 免费档)
IMAGE_PROVIDER=pollinations

# ---- 豆包 / 即梦 Seedream (火山方舟, 付费) ----
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seedream-4.5

# ---- Google Gemini 图像生成 (AI Studio 免费档, 不绑卡, 约 500 张/天) ----
# 申请: https://aistudio.google.com/apikey
# 模型: gemini-2.5-flash-image(默认, 即 Nano Banana, 免费里质量最高)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# ---- Cloudflare Workers AI (免费档 10000 neurons/天 ≈ 230 张 FLUX.1 schnell) ----
# 申请: https://dash.cloudflare.com/profile/api-tokens (账号 ID 在右侧)
# 仅需一个具备 Workers AI 权限的 API Token (Account API Token 勾选 Workers AI)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/black-forest-labs/flux-1-schnell
