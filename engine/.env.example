# 生图引擎配置 (复制本文件为同目录 .env 并按需填写)
# 不填任何 Key 时, 默认走免费 Pollinations FLUX 兜底 (速度慢/偶有限流, 但可用)。
#
# 想免费升级质量? 国内可达、注册即送额度、不用绑卡:
#   1) 硅基流动 SiliconFlow -> 申请: https://cloud.siliconflow.cn (FLUX.1-schnell / KWAI-Kolors 免费)
#   2) Cloudflare Workers AI -> 申请免费 Token: https://dash.cloudflare.com/profile/api-tokens
# 把对应 Key 填好, 并把 IMAGE_PROVIDER 改成 siliconflow / cloudflare 即可, 全程 0 元。
# 注: Google Gemini / HuggingFace 在当前网络环境下被墙, 不可用。

# 生图源: pollinations(默认免费) | siliconflow(硅基流动, 推荐免费)
#        | doubao(豆包/即梦 Seedream) | gemini(墙, 不可用)
#        | cloudflare(Cloudflare 免费档)
IMAGE_PROVIDER=pollinations

# ---- 豆包 / 即梦 Seedream (火山方舟, 付费) ----
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seedream-4.5

# ---- Google Gemini 图像生成 (AI Studio 免费档, 不绑卡, 约 500 张/天) ----
# 申请: https://aistudio.google.com/apikey
# 模型: gemini-2.5-flash-image(默认, 即 Nano Banana, 免费里质量最高)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# ---- Cloudflare Workers AI (免费档 10000 neurons/天 ≈ 230 张 FLUX.1 schnell) ----
# 申请: https://dash.cloudflare.com/profile/api-tokens (账号 ID 在右侧)
# 仅需一个具备 Workers AI 权限的 API Token (Account API Token 勾选 Workers AI)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/black-forest-labs/flux-1-schnell

# ---- 硅基流动 SiliconFlow (国内可达, 注册送免费额度, 推荐) ----
# 申请: https://cloud.siliconflow.cn (控制台 -> API密钥)
# 免费模型: black-forest-labs/FLUX.1-schnell, KWAI-Kolors/Kolors
SF_API_KEY=
SF_BASE_URL=https://api.siliconflow.cn/v1
SF_MODEL=black-forest-labs/FLUX.1-schnell

# ---- 真实视频 AI 后端 (多模型自动串联, 填哪个 Key 就用哪个) ----
# 仅 video / comic 两个视频站用到。引擎会按「用户指定(VIDEO_PROVIDER) -> 其余已配 Key 的模型」
# 自动串联: 任一模型繁忙/失败会自动切换下一个, 全部不可用才回退静态分镜兜底。
# 把任意一个(或多个) Key 填好即生效, 无需改 VIDEO_PROVIDER; 想固定优先模型可设 VIDEO_PROVIDER。
# 各平台: 注册均送免费额度, 付不付钱都行。
#   智谱 CogVideoX/清影 -> https://open.bigmodel.cn  (cogvideox-flash 免费, 推荐)
#   阿里通义万相       -> https://dashscope.console.aliyun.com
#   可灵 Kling        -> https://klingai.com  (快手开放平台)
#   海螺 Minimax       -> https://www.minimax.io  (视频模型 video-01)
#   腾讯混元 Hunyuan   -> https://cloud.tencent.com/product/hunyuan
#   Pollinations       -> https://enter.pollinations.ai/keys
# 不填任何视频 Key -> 自动用「静态分镜兜底」(真实 AI 图 + 多镜头拼长片, 无运镜)。
VIDEO_PROVIDER=kenburns
# 智谱 CogVideoX / 清影 (免费额度, 推荐)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=cogvideox-flash
# 阿里通义万相
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_T2V_MODEL=wanx2.1-t2v-video-synthesis
DASHSCOPE_I2V_MODEL=wanx2.1-i2v-video-synthesis
# 可灵 Kling
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com/v1
KLING_MODEL=kling-v1-6
# 海螺 Minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=video-01
# 腾讯混元 Hunyuan 视频
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_VIDEO_MODEL=hunyuan-video
# Pollinations 视频 (需 Key)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
# 火山引擎 Seedance 视频 (Volcengine Ark, 真实文生视频, 已验证可用)
VOLC_API_KEY=
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_MODEL=doubao-seedance-1-0-pro-fast-251015
# 多镜头工作流: 拆 N 个分镜各生成短视频再用 ffmpeg 拼接成更长的成片
VIDEO_SCENES=3
VIDEO_CLIP_DURATION=5
